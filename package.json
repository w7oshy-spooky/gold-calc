{
  "name": "gold-calc-saudi",
  "version": "2.0.0",
  "description": "Smart Saudi Gold Counter Assistant & Stealth Auditor",
  "main": "gold-calculator.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-syntax.js",
    "stamp:sw": "node scripts/stamp-sw.js",
    "build:mobile": "node scripts/build-mobile.js",
    "build:apk": "node scripts/build-apk.js",
    "build:css": "tailwindcss -c tailwind.config.js -o tailwind.css --minify",
    "assets:generate": "capacitor-assets generate --assetPath assets",
    "cap:sync": "npm run build:mobile && cap sync",
    "cap:android": "npm run build:mobile && cap sync android && cap open android",
    "cap:ios": "npm run build:mobile && cap sync ios && cap open ios"
  },
  "keywords": [
    "gold",
    "calculator",
    "saudi-arabia",
    "jewelry",
    "zatca",
    "sharia",
    "pwa",
    "capacitor"
  ],
  "author": "w7oshy",
  "license": "MIT",
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^9.1.2",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.4"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "tailwindcss": "^3.4.17"
  },
  "allowScripts": {
    "sharp@0.32.6": true
  }
}
